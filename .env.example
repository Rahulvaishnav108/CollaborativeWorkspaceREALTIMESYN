# Environment
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/syncspace

# Redis
REDIS_URL=redis://localhost:6379

# Application URLs
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Authentication
SESSION_SECRET=replace_with_a_long_random_secret_minimum_32_characters
JWT_SECRET=replace_with_another_long_random_secret_minimum_32_characters

# Email Configuration (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@syncspace.com

# File Storage (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=syncspace-files
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PUBLIC_URL=http://localhost:9000

# AI Features (Optional - for chat assistant)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Limits
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx,ppt,pptx,txt,md

# Collaboration
MAX_DOCUMENT_HISTORY=50
DOCUMENT_AUTOSAVE_INTERVAL=5000

# Logging
LOG_LEVEL=info
LOG_FORMAT=combined

# Security
CORS_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Development
ENABLE_API_DOCS=true
ENABLE_PLAYGROUND=true